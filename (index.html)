<!DOCTYPE html>
<html lang="en" id="htmlRoot" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Remal Hotel & Villas - Front Desk & Laundry Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #FAFAFA; color: #222222; }
        .font-serif-luxury { font-family: 'Playfair Display', serif; }
        .scrollbar-none::-webkit-scrollbar { display: none; }
        .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }
        .bg-remal-sand { background-color: #E2B383; }
        .text-remal-sand { color: #DCA773; }
        .remal-card { background: #FFFFFF; border: 1px solid #EAEAEA; box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08); }
        
        @keyframes pulse-red {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.85; transform: scale(1.02); }
        }
        .pulse-notification { animation: pulse-red 1s infinite; }
    </style>
</head>
<body class="min-h-screen pb-20">

    <audio id="hotelAlarmSound" loop preload="auto">
        <source src="https://actions.google.com/sounds/v1/alarms/digital_watch_alarm_long.ogg" type="audio/ogg">
    </audio>

    <header class="bg-white sticky top-0 z-50 border-b border-stone-200 shadow-sm">
        <div class="max-w-3xl mx-auto px-5 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <h1 class="text-sm font-serif-luxury text-stone-900 font-bold tracking-widest">REMAL</h1>
                <p class="text-[8px] text-stone-500 uppercase tracking-wider">Hotel & Villas</p>
            </div>
            <div class="flex items-center space-x-3">
                <div class="flex bg-stone-100 p-1 rounded-full border border-stone-200 text-[11px] font-semibold">
                    <button onclick="setLang('en')" id="btn-lang-en" class="px-2.5 py-1 rounded-full bg-remal-sand text-white shadow-sm">EN</button>
                    <button onclick="setLang('ar')" id="btn-lang-ar" class="px-2.5 py-1 rounded-full text-stone-600 hover:text-stone-900">العربية</button>
                </div>
                <span class="text-xs font-bold bg-stone-900 text-white px-3 py-1.5 rounded-full shadow">🛎️ Reception & Laundry</span>
            </div>
        </div>
    </header>

    <div id="laundryPlantAlert" class="hidden bg-rose-600 text-white px-4 py-3 text-center text-xs font-bold tracking-wide shadow-md pulse-notification flex items-center justify-between gap-2">
        <div class="flex items-center gap-2 text-left">
            <span>🚨</span>
            <div>
                <p id="alertTitleText" class="font-bold">New Laundry Request Received!</p>
                <p id="alertClientNote" class="text-[11px] font-normal italic opacity-95 text-amber-100 mt-0.5"></p>
            </div>
        </div>
        <button onclick="stopAlarmAndTransfer()" class="bg-white text-rose-700 hover:bg-rose-50 px-3.5 py-2 rounded-xl font-bold text-xs shadow-lg transition whitespace-nowrap cursor-pointer">🔕 Stop Alarm</button>
    </div>

    <div class="max-w-2xl mx-auto px-4 py-4 space-y-4">
        <div class="grid grid-cols-4 gap-1.5 pt-1 text-[11px] font-bold">
            <button onclick="switchMainSection('newRecord')" id="navBtnNewRecord" class="py-2.5 px-1 rounded-2xl bg-remal-sand text-white shadow-md transition flex flex-col items-center justify-center gap-0.5"><span>➕</span> New</button>
            <button onclick="switchMainSection('liveRecord')" id="navBtnLiveRecord" class="py-2.5 px-1 rounded-2xl bg-stone-100 border border-stone-200 text-stone-700 transition flex flex-col items-center justify-center gap-0.5"><span>🔴</span> Live</button>
            <button onclick="switchMainSection('pdfList')" id="navBtnPdfList" class="py-2.5 px-1 rounded-2xl bg-stone-100 border border-stone-200 text-stone-700 transition flex flex-col items-center justify-center gap-0.5"><span>📋</span> PDF</button>
            <button onclick="switchMainSection('dashboard')" id="navBtnDashboard" class="py-2.5 px-1 rounded-2xl bg-stone-100 border border-stone-200 text-stone-700 transition flex flex-col items-center justify-center gap-0.5"><span>📈</span> Chart</button>
        </div>

        <div id="sectionNewRecord" class="space-y-4">
            <div class="remal-card p-6 rounded-3xl space-y-5">
                <h2 class="text-lg font-serif-luxury font-bold text-stone-900 border-b border-stone-100 pb-3">New Record</h2>
                <div>
                    <label class="block text-xs font-bold text-stone-600 mb-1">Room Number</label>
                    <input type="number" id="roomNumber" placeholder="e.g., 104, 223..." class="w-full border border-stone-200 rounded-xl p-3 text-sm font-bold bg-stone-50 outline-none">
                    <p id="roomErrorMsg" class="hidden text-rose-600 text-xs font-bold mt-1.5">⚠️ Invalid room number!</p>
                </div>
                <div class="flex bg-stone-100 p-1.5 rounded-2xl border border-stone-200 text-xs font-bold gap-2">
                    <button onclick="selectCountType('hotel')" id="btn-count-hotel" class="flex-1 py-2.5 rounded-xl bg-remal-sand text-white shadow-md">🏨 Hotel Count (Free)</button>
                    <button onclick="selectCountType('guest')" id="btn-count-guest" class="flex-1 py-2.5 rounded-xl text-stone-600">💳 Guest Count</button>
                </div>
                <div class="flex gap-2 text-xs font-bold">
                    <button onclick="switchService('laundry')" id="tab-service-laundry" class="flex-1 py-2.5 rounded-xl bg-stone-900 text-white">LAUNDRY</button>
                    <button onclick="switchService('dry')" id="tab-service-dry" class="flex-1 py-2.5 rounded-xl bg-stone-100 text-stone-700">DRY CLEANING</button>
                    <button onclick="switchService('pressing')" id="tab-service-pressing" class="flex-1 py-2.5 rounded-xl bg-stone-100 text-stone-700">PRESSING</button>
                </div>
                <div id="itemsContainer" class="space-y-3 max-h-80 overflow-y-auto pr-1 scrollbar-none"></div>
                <div class="bg-amber-50 border border-amber-200 text-amber-900 p-3.5 rounded-2xl flex justify-between items-center font-bold text-xs">
                    <span>Total Garments:</span>
                    <span id="currentBordereauCount" class="bg-remal-sand text-white px-3 py-1 rounded-full text-xs">0 pieces</span>
                </div>
                <div class="bg-stone-50 border border-stone-200 p-4 rounded-2xl text-xs space-y-1.5 font-medium text-stone-800">
                    <div class="flex justify-between"><span>Subtotal:</span><span id="subTotal">0.00 AED</span></div>
                    <div class="flex justify-between"><span>VAT (5%):</span><span id="vatAmount">0.00 AED</span></div>
                    <div class="flex justify-between font-bold text-sm text-stone-900 border-t border-stone-200 pt-2 mt-1"><span>Grand Total:</span><span id="grandTotal" class="text-remal-sand font-serif-luxury text-base">0.00 AED</span></div>
                </div>
                <button id="btnSaveRecord" class="w-full bg-stone-900 hover:bg-stone-800 text-white font-bold py-3.5 rounded-xl text-sm shadow-lg transition">💾 Save Record</button>
            </div>
        </div>

        <div id="sectionLiveRecord" class="hidden space-y-4">
            <div class="remal-card p-6 rounded-3xl space-y-4">
                <h3 class="text-sm font-serif-luxury font-bold text-stone-900 border-b border-stone-100 pb-3">🔴 Live Laundry Orders</h3>
                <div id="liveOrdersList" class="space-y-3"><p class="text-xs text-stone-400 text-center py-4">Loading live orders...</p></div>
            </div>
        </div>

        <div id="sectionPdfList" class="hidden space-y-4">
            <div class="remal-card p-6 rounded-3xl space-y-4">
                <h3 class="text-sm font-serif-luxury font-bold text-stone-900 border-b border-stone-100 pb-3">PDF List & Records</h3>
                <div id="laundryList" class="space-y-3"><p class="text-xs text-stone-400 text-center py-4">Loading records...</p></div>
            </div>
        </div>

        <div id="sectionDashboard" class="hidden space-y-4">
            <div class="remal-card p-6 rounded-3xl space-y-5">
                <h3 class="text-sm font-serif-luxury font-bold text-stone-900 border-b border-stone-100 pb-3">📈 Analytics Dashboard</h3>
                <div class="grid grid-cols-3 gap-3 text-center">
                    <div class="bg-stone-50 p-3 rounded-xl border"><p class="text-[10px] font-bold text-stone-400">Revenue</p><p id="kpiRevenue" class="text-sm font-bold text-remal-sand">0.00 AED</p></div>
                    <div class="bg-stone-50 p-3 rounded-xl border"><p class="text-[10px] font-bold text-stone-400">Orders</p><p id="kpiOrders" class="text-sm font-bold text-stone-900">0</p></div>
                    <div class="bg-stone-50 p-3 rounded-xl border"><p class="text-[10px] font-bold text-stone-400">Garments</p><p id="kpiGarments" class="text-sm font-bold text-stone-900">0 pcs</p></div>
                </div>
            </div>
        </div>
    </div>

    <script type="module">
        import { initLaundryModule, selectCountType, switchService } from './src/laundry-logic.js';
        
        window.selectCountType = selectCountType;
        window.switchService = switchService;

        window.switchMainSection = function(section) {
            ['newRecord', 'liveRecord', 'pdfList', 'dashboard'].forEach(sec => {
                document.getElementById(`section${sec.charAt(0).toUpperCase() + sec.slice(1)}`).classList.add('hidden');
                document.getElementById(`navBtn${sec.charAt(0).toUpperCase() + sec.slice(1)}`).className = "py-2.5 px-1 rounded-2xl bg-stone-100 border border-stone-200 text-stone-700 transition flex flex-col items-center justify-center gap-0.5 font-bold";
            });
            document.getElementById(`section${section.charAt(0).toUpperCase() + section.slice(1)}`).classList.remove('hidden');
            document.getElementById(`navBtn${section.charAt(0).toUpperCase() + section.slice(1)}`).className = "py-2.5 px-1 rounded-2xl bg-remal-sand text-white shadow-md transition flex flex-col items-center justify-center gap-0.5 font-bold";
        }

        window.setLang = function(lang) {
            document.getElementById('htmlRoot').setAttribute('dir', lang === 'ar' ? 'rtl' : 'ltr');
            document.getElementById('btn-lang-en').className = lang === 'en' ? "px-2.5 py-1 rounded-full bg-remal-sand text-white shadow-sm font-bold" : "px-2.5 py-1 rounded-full text-stone-600";
            document.getElementById('btn-lang-ar').className = lang === 'ar' ? "px-2.5 py-1 rounded-full bg-remal-sand text-white shadow-sm font-bold" : "px-2.5 py-1 rounded-full text-stone-600";
        }

        window.stopAlarmAndTransfer = function() {
            document.getElementById('laundryPlantAlert').classList.add('hidden');
            window.switchMainSection('liveRecord');
        }

        document.addEventListener('DOMContentLoaded', () => {
            initLaundryModule();
        });
    </script>
</body>
</html>
